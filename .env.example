# Talk N Type — environment variables (names only; NEVER commit real values).
# Local development: copy to .env and fill in. Production: set these in the
# Render (API + Python) and Vercel (frontend) dashboards.

# ───────────── Node API (Render web service, server.js) ─────────────
NODE_ENV=
PORT=
MONGODB_URI=
# Signing key for login JWTs: random, at least 32 characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Lifetime of browser Deepgram tokens in seconds (30–600, default 60).
DEEPGRAM_TOKEN_TTL_SECONDS=
# Dictation tokens per signed-in user per minute (default 6).
DEEPGRAM_TOKENS_PER_MINUTE=
# "on" (default) rewrites legacy plain-text passwords to bcrypt at login; "off" keeps
# accepting them without rewriting (keeps a rollback to the old code possible).
LEGACY_PASSWORD_UPGRADE=
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_BASE_URL=
CACHE_TTL_SECONDS=
TNT_AI_MODEL=
TNT_AI_MAX_TOKENS=
# Python AI service: its base URL and the secret shared ONLY between Node and Python (>= 32 chars).
# LEGAL_AI_SERVICE_* (from main) is used by the Legal AI workspace gateway and, as a fallback,
# by /api/brain and Python's BrainAuth - setting just this pair is enough. BRAIN_* overrides it.
LEGAL_AI_SERVICE_URL=
LEGAL_AI_SERVICE_KEY=
BRAIN_URL=
BRAIN_SHARED_SECRET=
BRAIN_MAX_UPLOAD_MB=
BRAIN_TIMEOUT_MS=
# Optional: administrator address that cannot be self-registered.
ADMIN_EMAIL=
# Features suspended for security maintenance (503). Unset/"default" = inquiries,team,
# payments,deepgram (main's containment); "none" = nothing; or a comma list.
RELEASE_CONTAINMENT=
# Optional rate limits (defaults in middleware/apiGuard.js).
USER_REQUESTS_PER_MINUTE=
USER_PAID_REQUESTS_PER_MINUTE=
LOGIN_ATTEMPTS_PER_15_MIN=
REGISTRATIONS_PER_HOUR=
# Optional resource limits (defaults in utils/resourceProtection.js).
API_BODY_MB=
AUDIO_UPLOAD_MB=
PDF_UPLOAD_MB=
SEARCHABLE_UPLOAD_MB=
DOCUMENT_UPLOAD_MB=
DOCUMENT_CONCURRENCY=
DOCUMENT_MAX_PAGES=
DOCUMENT_MAX_IMAGE_PIXELS=
DOCUMENT_MAX_RASTER_PIXELS=
DOCUMENT_TIMEOUT_MS=
AI_CONCURRENCY=
AI_REQUESTS_PER_MINUTE=
AI_TIMEOUT_MS=
BODY_CONCURRENCY=
BODY_TIMEOUT_MS=
CSV_MAX_ROWS=
OCR_PROCESS_BUDGET_MB=

# ───────────── Python AI service (Render, TNT_BRAIN/server.py) ─────────────
# Must equal the Node API's secret: LEGAL_AI_SERVICE_KEY (used by the workspace gateway
# and BrainAuth) or BRAIN_SHARED_SECRET.
# LEGAL_AI_SERVICE_KEY=
# BRAIN_SHARED_SECRET=
# OPENAI_API_KEY=
TAVILY_API_KEY=
INDIAN_KANOON_API_KEY=
# Comma-separated; default https://talkntype.pro,https://www.talkntype.pro
BRAIN_ALLOWED_ORIGINS=
DOCUMENT_DB_DIR=
DOCUMENT_DB_TTL_SECONDS=
DOCUMENT_MAX_OPEN=
OCR_MAX_PAGES=

# ───────────── Frontend (Vercel build-time, must start with VITE_) ─────────────
# REQUIRED for production builds (the build stops without it): the Node API origin,
# https only, e.g. https://talkntypeai.onrender.com
VITE_API_URL=
VITE_DRAFT_API_URL=

# ───────────── One-off scripts (set only when running them) ─────────────
# scripts/create-admin.mjs: ADMIN_EMAIL (above) and optional ADMIN_NAME.
# The password is typed at a hidden prompt or piped on stdin; ADMIN_PASSWORD is refused.
# ADMIN_NAME=
# scripts/assign-orphan-records.mjs
# OWNER_EMAIL=
